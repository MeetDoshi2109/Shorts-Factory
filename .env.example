# ── Gemini AI (free at https://aistudio.google.com) ─────────────────
GEMINI_API_KEY=<your-gemini-api-key>

# ── YouTube OAuth2 (see SETUP_GUIDE.md for how to get these) ─────────
YOUTUBE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=<your-client-secret>

# ── Channel Settings ───────────────────────────────────────────────
CHANNEL_NICHE=Book Summaries
CHANNEL_TARGET_AUDIENCE=young adults 18-35
UPLOAD_PRIVACY=public
DAILY_UPLOAD_COUNT=3

# ── Video Settings ─────────────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_MAX=58

# ── Optional: Email Digest (leave blank to disable) ───────────────
SMTP_FROM_EMAIL=meetdoshi2106@gmail.com
SMTP_APP_PASSWORD=YashMeet@633821   
SMTP_TO_EMAIL=

# ── App Settings ───────────────────────────────────────────────────
DASHBOARD_PORT=8899
LOG_LEVEL=INFO
